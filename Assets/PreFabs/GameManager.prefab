--- !u!114 &2112239135348994177
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3143616090737476748}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Word Dawg is an exciting new game where you can create words and then
    modify them to make new words.\r\n\r\nTo begin, you will be dealt a rack of seven
    letters. Tap letters in the rack to create your first new word. Words must be
    at least three letters. To submit, click the Submit button or swipe right on
    your word. Each new word will display in a list below and new letters will be
    added to the rack.\r\n\r\nAfter that, you may continue to make new words. Better
    yet,the fun begins and you earn even more points when you start to modify the
    words you\u2019ve already created. You may add prefixes, suffixes or rearrange
    the letters to make new words. For example, if your first word is CAT, you might
    turn it into CATS or CART or ACTOR depending on the letters in the rack.\r\n\r\nTo
    do that, tap the word you want to modify and it will be displayed beneath the
    rack of letters. Tap the letters from the selected word plus letters in the rack
    to make a new word. You can use the letters in any order but you MUST use ALLof
    them. Plus you must use at least ONE letter from the rack. After you modify the
    word and hit Submit,the original word will be replaced and displayed at the top
    of your list of words.\r\n\r\nIf you make a mistake, you can deselect individual
    letters by tapping them or clicking the Reset button.If you get stuck, you can
    replace the rack with new letters by swiping left on the rack or clicking the
    Rack button.\r\n\r\nThe game is over when you run out of letters or time, depending
    on which variation of the game you selected to play. You will see the results
    of your current and highest scores and best words.\r\n\r\nSee the Games help
    section to explore variations of the game. These include timed, untimed, and
    customized possibilities as well as a Game of The Day. See the Gestures section
    for various swiping and clicking shortcuts to make playing more fun and faster.
    See the Scoring help for more details on how points are calculated so you can
    maximize your score.\r\n\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
