--- !u!114 &8381851678391243433
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6685796674132274899}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Scoring is based on the value of each letter (below) and the length of
    the word. You will earn more points by modifying your existiing words to make
    longer words. Replacing the rack will subtract 50 points.\r\n\nHere are the gory
    details. First, the letter values of the word are added up. If the word is five
    letters or more, this number is multiplied by the length of the word minus one,
    then multiplied by 1.5.  The one exception is if you only add an S or a D, the
    value is not multiplied by 1.5. \n\nFor example, if you have a four letter word
    whose letter values add up to 10, the word score will be 10. But, if you have
    a five letter word whose letter values add up to 10, the word score will be 60.
    A six lerrer word whose letter scores add up to 10 will have a word score of
    75.\n\nThis is the formula:  \n   letterScore *  (length-1)*1.5 )\n\n   \nLetter
    Scores\n    A = 1 \r\n    B = 4 \r\n    C = 4 \r\n    D = 2 \r\n    E = 1 \r\n   
    F = 4 \r\n    G = 4\r\n    H = 5\r\n    I = 1 \r\n    J = 8\r\n    K = 6\r\n   
    L = 3\r\n    M = 4\r \n    N = 2\r\n    O = 1\r\n    P = 4\r\n    Q = n/a\r\n   
    R = 3\r\n    S = 1\r\n    T = 2 \r\n    U = 4\r\n    V = 6\r\n    W = 4\r\n   
    X = 10\r\n    Y = 4 \r\n    Z = 1\r\n\r\n\r\n\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
